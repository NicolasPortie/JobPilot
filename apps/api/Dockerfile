FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY JobPilot.slnx Directory.Build.props ./
COPY apps/api/JobPilot.Api.csproj apps/api/
RUN dotnet restore apps/api/JobPilot.Api.csproj
COPY apps/api apps/api
RUN dotnet publish apps/api/JobPilot.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "JobPilot.Api.dll"]
