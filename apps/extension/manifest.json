{
  "manifest_version": 3,
  "name": "JobPilot",
  "version": "0.1.4",
  "description": "Automacao assistida de candidaturas com auditoria e controle pelo JobPilot.",
  "permissions": ["activeTab", "alarms", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.gupy.io/*",
    "https://*.gupy.com.br/*",
    "https://*.indeed.com/*",
    "https://*.inhire.app/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JobPilot",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://*.gupy.io/*",
        "https://*.gupy.com.br/*",
        "https://*.indeed.com/*",
        "https://*.inhire.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
