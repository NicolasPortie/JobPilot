POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=jobpilot
JOBPILOT_JWT_KEY=replace-with-at-least-32-random-characters
JOBPILOT_SECRET_KEY=replace-with-an-independent-32-character-key
JOBPILOT_BOOTSTRAP_EMAIL=admin@example.com
JOBPILOT_BOOTSTRAP_PASSWORD=replace-with-a-strong-bootstrap-password
# Ative apenas para criar o usuário no primeiro boot; depois volte para false.
JOBPILOT_SEED_ON_STARTUP=false
JOBPILOT_BOOTSTRAP_COUNTRY=
JOBPILOT_BOOTSTRAP_TARGET_ROLE=
JOBPILOT_FRONTEND_ORIGINS=http://localhost:8080
JOBPILOT_PORT=8080
# Hosts extras de IA além dos conhecidos (api.openai.com, api.anthropic.com,
# api.kimi.com), separados por vírgula. Vazio = só conhecidos + Ollama local.
# Mapeia para Ai:AllowedHosts (use __ como separador).
Ai__AllowedHosts=
